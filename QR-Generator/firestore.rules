rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidUserCreate(data) {
      return data.keys().hasAll(['email', 'createdAt', 'updatedAt']) 
        && data.keys().size() <= 6
        && data.email is string && data.email.size() <= 256
        && (data.get('displayName', null) == null || data.displayName is string)
        && (data.get('photoURL', null) == null || data.photoURL is string)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidUserUpdate(data) {
      return data.keys().hasAll(['email', 'createdAt', 'updatedAt']) 
        && data.keys().size() <= 6
        && data.email is string && data.email.size() <= 256
        && (data.get('displayName', null) == null || data.displayName is string)
        && (data.get('photoURL', null) == null || data.photoURL is string)
        && data.updatedAt == request.time;
    }

    function isValidQRConfigCreate(data, userId) {
      return data.keys().hasAll(['name', 'data', 'config', 'userId', 'createdAt', 'updatedAt'])
        && data.keys().size() == 6
        && data.name is string && data.name.size() <= 128
        && data.data is string && data.data.size() <= 2048
        && data.config is map
        && data.userId == userId
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidQRConfigUpdate(data, userId) {
      return data.keys().hasAll(['name', 'data', 'config', 'userId', 'createdAt', 'updatedAt'])
        && data.keys().size() == 6
        && data.name is string && data.name.size() <= 128
        && data.data is string && data.data.size() <= 2048
        && data.config is map
        && data.userId == userId
        && data.updatedAt == request.time;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserCreate(incoming());
      allow update: if isOwner(userId) && isValidUserUpdate(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        && incoming().createdAt == existing().createdAt;
    }

    match /users/{userId}/qrConfigs/{configId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(configId) && isValidQRConfigCreate(incoming(), userId)
        && exists(/databases/$(database)/documents/users/$(userId));
      allow update: if isOwner(userId) && isValidQRConfigUpdate(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'data', 'config', 'updatedAt'])
        && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId);
    }
  }
}
